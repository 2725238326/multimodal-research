{
  "experiment_id": "material_photometric_external_confirmation_v0",
  "status": "planned_confirmatory_stress_test",
  "source": {
    "project_url": "https://projects.csail.mit.edu/illumination/",
    "archive_url": "https://data.csail.mit.edu/multilum/multi_illumination_test_mip2_jpg.zip",
    "archive_sha256": "7a142f0f4dcf8c6b038f91a32eee5962a12aa68e5c4ee43adf0d3059ea0f0ce0",
    "license": "CC-BY-4.0",
    "sdk_repository": "https://github.com/lmurmann/multi_illumination",
    "sdk_revision": "a85aa9253065ff836ea97ba1a04b14259a06b3e0",
    "sdk_license": "MIT"
  },
  "split": {
    "train": "existing 30 non-everett development scenes",
    "test": "all 30 official everett test scenes",
    "forbid_scene_overlap": true
  },
  "crop": {
    "source_mip": 2,
    "analysis_mip": 4,
    "downsample_factor": 4,
    "crop_size": 64,
    "min_component_area": 1024,
    "min_crop_purity": 0.82,
    "max_regions": 80,
    "min_regions": 60,
    "max_regions_per_scene_class": 2,
    "lights_per_region": 5,
    "test_scene_prefix": "everett",
    "target_material_ids": [4, 8, 12, 13, 15, 17, 21, 22, 23, 27, 32]
  },
  "seeds": [20260801, 20260802, 20260803],
  "rgb_sample_head": {
    "pca_components_max": 32,
    "C": 1.0,
    "max_iter": 5000,
    "class_weight": "balanced"
  },
  "region_head": {
    "pca_components_max": 16,
    "C": 1.0,
    "max_iter": 5000,
    "class_weight": "balanced"
  },
  "conditions": [
    "siglip_sample_majority",
    "siglip_region_mean",
    "photometric_censored_only",
    "siglip_plus_censored",
    "siglip_plus_exposure_only",
    "siglip_plus_shuffled"
  ],
  "primary_condition": "siglip_plus_censored",
  "metrics": {
    "primary": "region_accuracy",
    "guardrail": "macro_class_accuracy",
    "bootstrap_unit": "test_scene",
    "bootstrap_draws": 10000,
    "ci_level": 0.95
  },
  "thresholds": {
    "accuracy_delta_min": 0.03,
    "accuracy_ci_low_above": 0.0,
    "shuffled_margin_min": 0.03,
    "macro_accuracy_drop_no_more_than": 0.0
  },
  "notes": [
    "The 64x64 test crop is a pre-registered scale-domain stress test; development crops are 96x96.",
    "No test label may be used for model selection, threshold selection, feature changes, or seed changes.",
    "A failure closes verifier training on this mechanism; a pass only authorizes a separately planned conflict verifier."
  ]
}
