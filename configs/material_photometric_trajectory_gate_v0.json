{
  "experiment_id": "material_photometric_trajectory_gate_v0",
  "status": "planned_exploratory",
  "source_experiment_id": "material_response_probe_v0",
  "seeds": [20260729, 20260730, 20260731],
  "split": {
    "strategy": "scene_grouped",
    "folds": 5,
    "unit": "scene",
    "forbid_scene_overlap": true
  },
  "photometry": {
    "near_white_threshold": 0.98,
    "near_dark_threshold": 0.02,
    "absolute_highlight_threshold": 0.9,
    "low_saturation_threshold": 0.2,
    "reliable_all_channel_clip_fraction_max": 0.2,
    "minimum_reliable_lights": 2,
    "luminance_quantiles": [0.1, 0.25, 0.5, 0.75, 0.9],
    "gradient_quantiles": [0.5, 0.9]
  },
  "conditions": [
    "siglip_region_mean",
    "photometric_censored_only",
    "siglip_plus_censored",
    "siglip_plus_uncensored",
    "siglip_plus_exposure_only",
    "siglip_plus_shuffled"
  ],
  "primary_condition": "siglip_plus_censored",
  "baseline_condition": "siglip_region_mean",
  "controls": [
    "siglip_plus_exposure_only",
    "siglip_plus_shuffled"
  ],
  "shallow_head": {
    "type": "pca_logistic_regression",
    "pca_components_max": 16,
    "C": 1.0,
    "max_iter": 5000,
    "class_weight": "balanced"
  },
  "metrics": {
    "primary": "region_accuracy",
    "guardrail": "macro_class_accuracy",
    "bootstrap_unit": "scene",
    "bootstrap_draws": 10000,
    "ci_level": 0.95
  },
  "thresholds": {
    "accuracy_delta_min": 0.03,
    "accuracy_ci_low_above": 0.0,
    "shuffled_margin_min": 0.03,
    "macro_accuracy_drop_no_more_than": 0.0
  },
  "notes": [
    "Pixel statistics are appearance measurements from sRGB JPEG crops, not calibrated BRDF estimates.",
    "All conditions use the same PCA dimension and shallow-head capacity.",
    "This is exploratory on the same 30 scenes and requires independent confirmation after any Go result.",
    "No new model or data download is required."
  ]
}
